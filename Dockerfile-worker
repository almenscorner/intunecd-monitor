# ── Base image ────────────────────────────────────────────────────────────────
FROM --platform=linux/amd64 python:3.12-slim-bookworm AS base

WORKDIR /intunecd

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN git config --global user.email "intunecd-monitor@intunecd.local" \
 && git config --global user.name "IntuneCD Monitor"

COPY requirements.txt .
RUN pip install --upgrade pip --quiet \
 && pip install --no-cache-dir -r requirements.txt

RUN useradd -m -u 1000 appuser

# ── Worker image ──────────────────────────────────────────────────────────────
FROM base AS worker

COPY . /intunecd
RUN mkdir -p /intunecd/git \
 && chown -R appuser:appuser /intunecd

RUN chmod u+x ./worker-entrypoint.sh

USER appuser

ENTRYPOINT ["/bin/bash", "-c", "./worker-entrypoint.sh"]
