# ─── Required ────────────────────────────────────────────────────────────────

# Random secret used for session signing and PAT encryption.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Azure Entra ID App Registration credentials
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# The app role value that grants admin access (set in Entra ID App Registration > App roles)
# Default used by deploy.ps1: intunecd_admin
ADMIN_ROLE=intunecd_admin

# Microsoft Graph delegated scopes as a JSON array string
# Leave as '[]' — the app uses application permissions (client credentials), not delegated
SCOPE='[]'

# ─── Application ─────────────────────────────────────────────────────────────

# Your organisation/company name shown in the UI
COMPANY_NAME=

# Public hostname of the app (e.g. intunecd-monitor.swedencentral.cloudapp.azure.com)
# Required for correct redirect URIs behind a reverse proxy
SERVER_NAME=

# Set to true when running behind an HTTPS reverse proxy (Caddy, nginx, etc.)
HTTPS_ONLY=false

# Timezone for scheduled tasks (IANA format, e.g. Europe/Stockholm, America/New_York)
TIMEZONE=UTC

# How long a user session stays valid (hours)
SESSION_LIFETIME_HOURS=3

# OAuth2 redirect path — must match the redirect URI in your App Registration
REDIRECT_PATH=/authorized

# ─── Database ─────────────────────────────────────────────────────────────────

# SQLite (local dev):
DATABASE_URL=sqlite:///./app.db
# PostgreSQL (production — used by docker-compose):
# DATABASE_URL=postgresql://postgres:yourpassword@db:5432/intunecd

# PostgreSQL superuser password — only needed when using the docker-compose stack
POSTGRES_PASSWORD=

# ─── Redis / Celery ───────────────────────────────────────────────────────────

# These default to the redis service in docker-compose; override only if using external Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_SESSION_URL=redis://redis:6379/1

# Optional: SQLAlchemy URI for Celery Beat task persistence across restarts
# If left blank, schedules are stored in memory and lost on beat container restart
# Example: postgresql://postgres:yourpassword@db:5432/intunecd
BEAT_DB_URI=

# ─── Documentation feature (optional) ────────────────────────────────────────

# Filename written to the backup repo by IntuneCD-startdocumentation
DOCUMENTATION_FILE_NAME=documentation.html

# Truncate documentation entries longer than this many characters (leave blank for no limit)
DOCUMENTATION_MAX_LENGTH=200

# ─── Reverse-proxy / Uvicorn ─────────────────────────────────────────────────

# Allow uvicorn to trust X-Forwarded-For from any upstream proxy.
# Set to the proxy container name or CIDR in production for tighter control.
FORWARDED_ALLOW_IPS=*
