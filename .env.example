# ── Database ────────────────────────────────────────────────────────────────
# SQLite (local dev, no setup needed)
DATABASE_URL=sqlite:///./app.db

# PostgreSQL (Docker Compose dev or production)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/intunecd

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string

# ── Azure Entra ID (Mandatory) ───────────────────────────────────────────────
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
SCOPE=["https://graph.microsoft.com/.default"]
REDIRECT_PATH=/authorized

# ── Authorization ─────────────────────────────────────────────────────────────
ADMIN_ROLE=IntuneCD.Admin

# ── Azure Key Vault (required for tenant PAT storage) ─────────────────────────
AZURE_VAULT_URL=https://your-vault.vault.azure.net/

# ── Application (optional) ───────────────────────────────────────────────────
COMPANY_NAME=
TIMEZONE=UTC
SESSION_LIFETIME_HOURS=3

# ── Celery / Redis ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
BEAT_DB_URI=sqlite:///./beat.db

# ── Documentation feature (optional) ─────────────────────────────────────────
DOCUMENTATION_ACTIVE=false
# AZURE_CONNECTION_STRING=
# AZURE_CONTAINER_NAME=
# DOCUMENTATION_FILE_NAME=
